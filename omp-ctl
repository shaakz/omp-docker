#!/usr/bin/env bash
# Host-side control for the omp container. Works standalone — install with:
#
#   mkdir -p ~/.local/bin
#   curl -fsSL -o ~/.local/bin/omp-ctl \
#     https://raw.githubusercontent.com/shaakz/omp-docker/main/omp-ctl
#   chmod +x ~/.local/bin/omp-ctl
#
#   omp-ctl attach          # attach to the agent TUI (ctrl-b d to detach)
#   omp-ctl collab [view]   # print a join link
#   omp-ctl status          # collab link + participants
#   omp-ctl ssh-key         # public key + fingerprint, to enrol in Forgejo
#   omp-ctl shell | logs | restart | stop | start | ps
#   omp-ctl up | down       # these two need the compose file (see below)
#
# Everything except up/down talks to the running container by name, so no
# checkout, no compose file, and no particular working directory is required.
# Override the container name with OMP_NAME if you changed it.
set -euo pipefail

CONTAINER="${OMP_NAME:-omp}"
SESSION="${OMP_TMUX_SESSION:-omp}"
USER_IN_CONTAINER=omp

die() { echo "omp-ctl: $*" >&2; exit 1; }

running() { [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = "true" ]; }

require_running() {
    running || die "container '${CONTAINER}' is not running (set OMP_NAME if you renamed it)"
}

# Only `up`/`down` need the compose file. Look where it plausibly lives: an
# explicit override, next to this script when run from a checkout, then the
# usual clone and stack-manager locations (Dockhand keeps stacks in
# /data/stacks/<name>, Portainer-style tools in /opt/stacks/<name>).
find_stack_dir() {
    local self=${BASH_SOURCE[0]} dir candidates=()
    while [ -L "$self" ]; do
        dir=$(cd -P "$(dirname "$self")" && pwd); self=$(readlink "$self")
        [[ $self != /* ]] && self="$dir/$self"
    done
    candidates+=(
        "${OMP_STACK_DIR:-}"
        "$(cd -P "$(dirname "$self")" && pwd)"
        "$PWD"
        "$HOME/omp-docker"
        "/data/stacks/omp-standalone"
        "/opt/stacks/omp-standalone"
    )
    for dir in "${candidates[@]}"; do
        [ -n "$dir" ] && [ -f "$dir/docker-compose.yml" ] && { printf '%s' "$dir"; return 0; }
    done
    return 1
}

compose() {
    local dir
    dir=$(find_stack_dir) || die "no docker-compose.yml found. Set OMP_STACK_DIR=/path/to/stack, or run this from the stack directory."
    docker compose -f "${dir}/docker-compose.yml" "$@"
}

cmd=${1:-attach}
[ $# -gt 0 ] && shift || true

case "$cmd" in
    attach)
        require_running
        exec docker exec -it -u "$USER_IN_CONTAINER" "$CONTAINER" tmux attach -t "$SESSION" ;;
    collab)
        require_running
        exec docker exec -u "$USER_IN_CONTAINER" "$CONTAINER" omp-collab "$@" ;;
    status)
        require_running
        exec docker exec -u "$USER_IN_CONTAINER" "$CONTAINER" omp-collab status ;;
    shell)
        require_running
        exec docker exec -it -u "$USER_IN_CONTAINER" "$CONTAINER" bash ;;
    ssh-key)
        require_running
        # -y needs to decrypt, so it fails on a passphrase-protected key even
        # though -l can still read the fingerprint. Say which case it is rather
        # than leaking "error in libcrypto".
        exec docker exec -u "$USER_IN_CONTAINER" "$CONTAINER" \
            sh -c 'k=${OMP_STATE_DIR:-$HOME/.omp}/ssh/id_ed25519
                   [ -f "$k" ] || { echo "no key yet — is FORGEJO_HOST set?" >&2; exit 1; }
                   ssh-keygen -lf "$k"
                   if ssh-keygen -y -P "" -f "$k" 2>/dev/null; then :
                   elif [ -s "${k}.pub" ]; then cat "${k}.pub"
                   else
                     echo "key is passphrase-protected — unusable by a headless agent." >&2
                     echo "supply a passphrase-less key, or unset FORGEJO_SSH_KEY_B64 to generate one." >&2
                     exit 1
                   fi' ;;
    logs)
        exec docker logs "$@" "$CONTAINER" ;;
    restart|stop|start)
        exec docker "$cmd" "$CONTAINER" ;;
    ps)
        exec docker ps -a --filter "name=^/${CONTAINER}$" ;;
    up)
        exec compose up -d "$@" ;;
    down)
        exec compose down "$@" ;;
    -h|--help|help)
        sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *)
        exec compose "$cmd" "$@" ;;
esac
