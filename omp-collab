#!/usr/bin/env bash
# Start (or re-print) the collab session in the running TUI and echo the join
# link, without needing to attach and type.
#
#   docker compose exec -u omp omp omp-collab          # full control
#   docker compose exec -u omp omp omp-collab view     # read-only
#   docker compose exec -u omp omp omp-collab status   # participants
#   docker compose exec -u omp omp omp-collab stop
#
# The room key lives only in the host process's memory, so every container
# restart invalidates the previous link — run this again after one.
set -euo pipefail

SESSION="${OMP_TMUX_SESSION:-omp}"
TARGET="${SESSION}:agent"
MODE="${1:-}"

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "no tmux session '${SESSION}' — is the container still starting?" >&2
    exit 1
fi

# With no client attached the pane is 80 columns and the join link wraps across
# lines, which would defeat the match below. Widen for the capture, then hand
# sizing back to whatever client attaches next.
# This types into the live TUI, so on any exit path clear the input line —
# otherwise a half-typed command is left sitting in the prompt of a session
# someone may be driving from another machine. Also hand window sizing back.
cleanup() {
    tmux send-keys -t "$TARGET" C-u 2>/dev/null || true
    tmux set-option -t "$SESSION" window-size latest 2>/dev/null || true
}
trap cleanup EXIT

# With no client attached the pane is 80 columns and the link wraps across
# lines, which would defeat the match below.
tmux set-option -t "$SESSION" window-size manual
tmux resize-window -t "$TARGET" -x 220 -y 50 2>/dev/null || true
sleep 1

# Start from an empty prompt, then type the command and send Enter separately
# so the command palette resolves first.
tmux send-keys -t "$TARGET" C-u
tmux send-keys -t "$TARGET" "/collab${MODE:+ $MODE}"
sleep 1
tmux send-keys -t "$TARGET" Enter

# Two shapes carry the link: `omp join "<link>"` after /collab, and the
# `my.omp.sh/#<link>` status line after /collab status. Match both — matching
# only the first makes `status` appear to work purely because an earlier
# /collab left its line on screen.
extract_link() {
    local pane=$1 link
    link=$(grep -o 'omp join "[^"]*"' <<<"$pane" | tail -1 | sed 's/^omp join "//; s/"$//')
    [ -n "$link" ] || link=$(grep -oE 'my\.omp\.sh/#[A-Za-z0-9._~-]+' <<<"$pane" | tail -1 | sed 's|^my\.omp\.sh/#||')
    printf '%s' "$link"
}

# When the command palette has a suggestion highlighted, the first Enter accepts
# the completion rather than submitting — the text stays in the input box. Send
# one more Enter if the command is still sitting there, but only once, so we
# never submit a stray empty prompt.
resent=0
for i in $(seq 1 20); do
    sleep 0.5
    pane="$(tmux capture-pane -p -t "$TARGET")"
    if [ "$resent" -eq 0 ] && [ "$i" -ge 3 ] && grep -q '╰─ */collab' <<<"$pane"; then
        tmux send-keys -t "$TARGET" Enter
        resent=1
    fi
    link="$(extract_link "$pane")"
    if [ -n "$link" ]; then
        printf 'join from another machine:\n  omp join "%s"\n\n' "$link"
        printf 'or in a browser:\n  https://my.omp.sh/#%s\n' "$link"
        exit 0
    fi
done

# stop, or any error path: show what the pane actually says rather than
# pretending we found a link. stdout, not stderr — `docker compose exec`
# allocates a TTY and stderr routed through it can be swallowed.
echo "no join link on screen — pane tail:"
tmux capture-pane -p -t "$TARGET" | grep -v '^$' | tail -12
exit 1
exit 1
