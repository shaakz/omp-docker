# Copy to .env and adjust per machine. This file is the only thing that differs
# between hosts — docker-compose.yml is byte-identical everywhere.
#
#   cp .env.example .env && $EDITOR .env

# --- host mount ------------------------------------------------------------
# Host directory exposed to the agent as /workspace. Required — the stack
# refuses to start without it.
WORKSPACE_DIR=/home/youruser/workspace

# uid/gid that should own files the agent creates in WORKSPACE_DIR.
# Match your host user: `id -u` / `id -g`.
PUID=1000
PGID=1000

# --- identity --------------------------------------------------------------
OMP_VERSION=17.2.15
OMP_IMAGE=omp-standalone:17.2.15
OMP_NAME=omp
# Set per machine — identifies this host in collab sessions.
OMP_HOSTNAME=omp-host1

# Container timezone. Match the host so timestamps line up.
TZ=Europe/Stockholm

# --- model backend ---------------------------------------------------------
# Any OpenAI-compatible endpoint (vLLM, llama.cpp server, TGI, a proxy...).
# Rendered into ~/.omp/agent/models.yml on every container start.
OMP_MODEL_PROVIDER=lan
OMP_MODEL_BASE_URL=http://<lan-host>:8000/v1

# MUST match what the server advertises, character for character, including any
# org/ prefix — it is sent verbatim as the request's `model` field, so a
# near-miss surfaces as "404 the model does not exist" only once you prompt.
# Check with:  curl -s http://<lan-host>:8000/v1/models
# The container also verifies this at startup and logs the served ids on
# mismatch, so `docker compose logs omp` will tell you.
OMP_MODEL_ID=<model-id-exactly-as-served>

OMP_MODEL_NAME=My LAN model
OMP_MODEL_API=openai-completions
# Take this from the endpoint's own max_model_len / context size.
OMP_MODEL_CONTEXT=131072
OMP_MODEL_MAX_TOKENS=32768
OMP_MODEL_REASONING=false

# Model the TUI starts on. Leave unset — it defaults to
# <OMP_MODEL_PROVIDER>/<OMP_MODEL_ID>, which is what you want. Set it only to
# start on some other provider's model, and include the provider prefix.
#OMP_MODEL=

# Extra flags for the auto-started agent, e.g. --thinking high
OMP_ARGS=

# Skip the first-run provider-login wizard (pointless for a keyless endpoint).
OMP_SKIP_SETUP=1

# --- other endpoints (optional, keyless, auto-discovered) ------------------
# omp registers these three as providers automatically when set, and discovers
# their models at runtime — no models.yml entry needed.
# OLLAMA_BASE_URL=http://<lan-host>:11434
# LLAMA_CPP_BASE_URL=http://<lan-host>:8080
# LM_STUDIO_BASE_URL=http://<lan-host>:1234/v1

# --- hosted providers (optional escape hatch) ------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- git identity for commits the agent makes ------------------------------
GIT_AUTHOR_NAME=you
GIT_AUTHOR_EMAIL=you@example.com

# Build source. Leave unset to build from the public repo (no clone needed);
# set to . on a machine where you edit these files locally.
#OMP_BUILD_CONTEXT=.

# --- GitHub (optional) -----------------------------------------------------
# Leave unset and run `gh auth login --web` inside the container instead.
# Set this to a fine-grained PAT to limit the agent to specific repos.
#GH_TOKEN=

# --- Forgejo / LAN git (optional) ------------------------------------------
# Unset FORGEJO_HOST to disable the SSH setup entirely.
#FORGEJO_HOST=192.168.1.157
#FORGEJO_SSH_PORT=222
#FORGEJO_WEB_URL=http://192.168.1.157:3001
# Private key, single line:  base64 -w0 ~/.ssh/id_ed25519
# Must have NO passphrase — a headless agent has no TTY to answer a prompt.
# Leave unset to have the container generate its own key on first boot
# (`omp-ctl ssh-key` then prints the public half to enrol in Forgejo).
#FORGEJO_SSH_KEY_B64=

# --- where the agent's state lives ------------------------------------------
# Unset  -> named volume `omp-state` (identical name on every machine, since
#           the compose project name is pinned).
# Set    -> an absolute host path, bind-mounted instead, so you can drop in your
#           own agents/commands/skills/AGENTS.md and browse it with filebrowser.
# Machine-local either way: it holds SQLite DBs and unix sockets, so don't put
# it on NFS or sync it live between machines.
#OMP_STATE_MOUNT=/home/youruser/omp-state
